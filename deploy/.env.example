# 复制为 .env 并填入真实值
# 对外端口(避开已被占用的 80)
APP_PORT=3000

# 数据库账号/库名(自动建库)
DB_USER=compact
DB_PASSWORD=change-me-strong-password
DB_NAME=compact

# JWT 签名密钥(建议 openssl rand -hex 32 生成)
JWT_SECRET=change-me-long-random-string

# 上传文件在宿主机的保存目录(必须为本地磁盘路径)
UPLOAD_HOST_DIR=/root/compact/uploads

# 可选:仅当对外已接入 HTTPS 时设为 true(纯 http 部署保持默认,否则浏览器拒绝 Secure cookie 导致登录态丢失)
# COOKIE_SECURE=true
